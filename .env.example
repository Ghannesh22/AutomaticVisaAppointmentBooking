# Applicant details
# The Step 5 form is only visible after a slot is selected. Dry-run mode logs
# detected required labels as step5_fields_detected before filling values.
# Do not commit your real .env file.
# Used by config.yaml when env_prefix is APPLICANT.
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_DATE_OF_BIRTH=
APPLICANT_REMARKS=
APPLICANT_SECURITY_ANSWER=
APPLICANT_DATA_PROCESSING_CONSENT=true
APPLICANT_SAVE_PERSONAL_DATA_LOCALLY=false
APPLICANT_NATIONALITY=
APPLICANT_PASSPORT_NUMBER=
APPLICANT_GENDER=male

# Gmail SMTP notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_SENDER=
EMAIL_APP_PASSWORD=
EMAIL_RECEIVER=

# Phone control page
# Generate a private token with:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
CONTROL_TOKEN=
# Optional: include your Tailscale or LAN phone-control URL in Telegram alerts.
# Example: CONTROL_PAGE_URL=http://100.x.y.z:8765
CONTROL_PAGE_URL=

# Telegram alerts for slot detections, CAPTCHA, and bot errors.
# Create a bot with @BotFather and set the token below.
# Anyone who sends /start to the bot is saved as a future alert recipient.
# Optional: run this once to confirm the current subscriber list:
# python -m src.telegram_setup
TELEGRAM_BOT_TOKEN=
# Optional static recipients. Most users can leave this empty now.
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_THROTTLE_SECONDS=300
