# Applicant details
# Fill these with the exact fields required by the website after a dry-run
# reaches the personal details page. Do not commit your real .env file.
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
